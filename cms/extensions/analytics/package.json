{
  "name": "directus-extension-analytics",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "directus:extension": {
    "type": "bundle",
    "path": {
      "app": "dist/app.js",
      "api": "dist/api.js"
    },
    "entries": [
      {
        "type": "endpoint",
        "name": "portfolio-analytics",
        "source": "src/endpoint/api.ts"
      },
      {
        "type": "hook",
        "name": "analytics-jobs",
        "source": "src/hook/api.ts"
      },
      {
        "type": "panel",
        "name": "portfolio-diagnostic-metrics",
        "source": "src/panels/diagnostic-metrics/app.ts"
      },
      {
        "type": "panel",
        "name": "portfolio-ordered-funnel",
        "source": "src/panels/ordered-funnel/app.ts"
      },
      {
        "type": "panel",
        "name": "portfolio-conversation-review",
        "source": "src/panels/conversation-review/app.ts"
      }
    ],
    "host": "^12.5.0"
  },
  "scripts": {
    "build": "directus-extension build",
    "dev": "directus-extension build --watch --no-minify",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@directus/errors": "3.0.0",
    "@portfolio/cms-schema": "workspace:*"
  },
  "devDependencies": {
    "@directus/extensions-sdk": "18.0.6",
    "@directus/types": "18.0.0",
    "@types/express": "4.17.21",
    "@types/node": "^24.19.2",
    "express": "4.22.3",
    "knex": "3.1.0",
    "typescript": "~6.0.3",
    "vite": "^8.1.2",
    "vitest": "^5.0.3",
    "vue": "^3.5.22"
  }
}
